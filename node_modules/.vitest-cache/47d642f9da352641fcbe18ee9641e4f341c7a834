K,WAAWkD,8BAAOC;eAAvB,CACE,iDAAC,SAAD;MAAO,SAAQ;gBAAiB;KAAc;;;;eAE9C,iDAAC,UAAD;MACE,IAAG;MACH,OAAOtC,OAAOrB,SAAS;MACvB,WAAWoD,QAAMnD,aAAamD,IAAEQ,OAAOC,KAAK;gBAH9C,CAKE,iDAAC,UAAD;OAAQ,OAAM;iBACXlD,kBAAkBJ,SAAS,IACxB,yBACA;MACE;;;;gBAEPI,kBAAkBmD,KAAKjD,QACtB,iDAAC,UAAD;OAAmB,OAAOQ,OAAOR,IAAEL,EAAE;iBAClCK,IAAEJ;MACG,GAFKI,IAAEL;;;;aAEP,CACT,CACK;;;;;aACL;;;;;;IAGL,iDAAC,OAAD;KAAK,WAAWkD,8BAAOC;eAAvB,CACE,iDAAC,SAAD;MAAO,SAAQ;gBAAoB;KAE5B;;;;eAEP,iDAAC,UAAD;MACE,IAAG;MACH,OAAOtC,OAAOzB,YAAY;MAC1B,WAAWwD,QAAMvD,gBAAgBuD,IAAEQ,OAAOC,KAAK;gBAE9CvD,iBAAiBwD,KAAKjD,QACrB,iDAAC,UAAD;OAEE,OAAOQ,OAAOR,IAAEL,MAAMK,IAAEM,YAAY;iBAEnCN,IAAEH,aAAaG,IAAEJ;MACZ,GAJDI,IAAEL,MAAMK,IAAEM;;;;aAIT,CACT;KACK;;;;aACL;;;;;;IAGJjB,MAAMK,SAAS,KACd,iDAAC,MAAD;KAAI,WAAWmD,8BAAOxD;eACnBA,MAAM4D,KAAKE,UAAUC,MACpB,iDAAC,MAAD,YAAaD,SAAa,GAAjBC;;;;YAAiB,CAC3B;IACC;;;;;IAIN,iDAAC,OAAD;KAAK,WAAWP,8BAAOQ;eAAvB,CACE,iDAAC,UAAD;MACE,MAAK;MACL,SAASlF;MACT,UAAUoB;gBACX;KAEO;;;;eAER,iDAAC,UAAD;MACE,MAAK;MACL,SAAS6B;MACT,UAAU7B;gBAETA,WAAW,gBAAgB;KACtB;;;;aACL;;;;;;GACF;;;;;;CACF;;;;;AAET;AAEA,oCAAetB","names":["paraNumero","valor","undefined","numero","Number","isInteger","ModalTarefa","aberto","onFechar","onSalvar","tarefa","coluna","prioridades","usuarios","projetos","usuario","useAuth","texto","setTexto","useState","idPrioridade","setIdPrioridade","idUsuario","setIdUsuario","idProjeto","setIdProjeto","erros","setErros","salvando","setSalvando","listaPrioridades","length","id","nome","descricao","projetosDoUsuario","filter","p","usuario_id","usuarioId","useEffect","idPri","prioridadeId","idprioridade","prioridade_id","String","usrId","projId","projetoId","projeto_id","usuarioPadrao","projetosIniciais","projetoInicial","handleUsuarioChange","novoIdUsuario","projetosFiltrados","novoProjetoId","handleSalvar","trim","usuarioIdCalculado","prioridadeIdNum","objPrioridade","find","prioridadeTexto","textoPrioridade","toLowerCase","normalize","replace","projetoIdCalculado","textoFinal","colunaFinal","payload","status","situacao","prioridade","id_prioridade","e","mensagensDeErro","response","data","message","erro","styles","campo","target","value","map","u","mensagem","i","botoes"],"ignoreList":[],"sources":["ModalTarefa.jsx"],"sourcesContent":["\r\nimport { useEffect, useState } from \"react\";\r\nimport { mensagensDeErro } from \"../pages/api.js\";\r\nimport { useAuth } from \"../contexts/AuthContext\";\r\nimport styles from \"./ModalTarefa.module.css\";\r\n\r\n// Converte valores para números inteiros positivos.\r\n// Se o valor estiver vazio ou inválido, retorna null.\r\nfunction paraNumero(valor) {\r\n  if (valor === null || valor === undefined || valor === \"\") {\r\n    return null;\r\n  }\r\n\r\n  const numero = Number(valor);\r\n\r\n  return Number.isInteger(numero) && numero > 0 ? numero : null;\r\n}\r\n\r\nfunction ModalTarefa({\r\n  aberto,\r\n  onFechar,\r\n  onSalvar,\r\n  tarefa = null,\r\n  coluna = \"afazer\",\r\n  prioridades = [],\r\n  usuarios = [],\r\n  projetos = [],\r\n}) {\r\n  const { usuario } = useAuth();\r\n\r\n  const [texto, setTexto] = useState(\"\");\r\n  const [idPrioridade, setIdPrioridade] = useState(\"2\");\r\n  const [idUsuario, setIdUsuario] = useState(\"\");\r\n  const [idProjeto, setIdProjeto] = useState(\"\");\r\n  const [erros, setErros] = useState([]);\r\n  const [salvando, setSalvando] = useState(false);\r\n\r\n  // Prioridades disponíveis\r\n  const listaPrioridades =\r\n    prioridades.length > 0\r\n      ? prioridades\r\n      : [\r\n          { id: 1, nome: \"baixa\", descricao: \"Baixa\" },\r\n          { id: 2, nome: \"media\", descricao: \"Média\" },\r\n          { id: 3, nome: \"alta\", descricao: \"Alta\" },\r\n        ];\r\n\r\n  // Projetos pertencentes ao usuário selecionado\r\n  const projetosDoUsuario = projetos.filter(\r\n    (p) =>\r\n      Number(p.usuario_id ?? p.usuarioId) === Number(idUsuario)\r\n  );\r\n\r\n  // Ao abrir o modal, carrega os dados\r\n  useEffect(() => {\r\n    if (!aberto) return;\r\n\r\n    setErros([]);\r\n\r\n    if (tarefa) {\r\n      // Edição de tarefa existente\r\n      setTexto(tarefa.texto || tarefa.descricao || \"\");\r\n\r\n      const idPri =\r\n        tarefa.prioridadeId ??\r\n        tarefa.idprioridade ??\r\n        tarefa.idPrioridade ??\r\n        tarefa.prioridade_id ??\r\n        2;\r\n\r\n      setIdPrioridade(String(idPri));\r\n\r\n      const usrId =\r\n        tarefa.usuarioId ??\r\n        tarefa.usuario_id ??\r\n        usuario?.id ??\r\n        usuarios[0]?.id ??\r\n        \"\";\r\n\r\n      setIdUsuario(String(usrId));\r\n\r\n      const projId =\r\n        tarefa.projetoId ??\r\n        tarefa.projeto_id ??\r\n        \"\";\r\n\r\n      setIdProjeto(String(projId));\r\n    } else {\r\n      // Criação de nova tarefa\r\n      const usuarioPadrao =\r\n        usuario?.id ?? usuarios[0]?.id ?? \"\";\r\n\r\n      setTexto(\"\");\r\n      setIdPrioridade(\"2\");\r\n      setIdUsuario(String(usuarioPadrao));\r\n\r\n      const projetosIniciais = projetos.filter(\r\n        (p) =>\r\n          Number(p.usuario_id ?? p.usuarioId) ===\r\n          Number(usuarioPadrao)\r\n      );\r\n\r\n      // Não inventa um ID quando o usuário não possui projeto\r\n      const projetoInicial = projetosIniciais[0]?.id ?? \"\";\r\n\r\n      setIdProjeto(String(projetoInicial));\r\n    }\r\n  }, [aberto, tarefa, prioridades, usuario, usuarios, projetos]);\r\n\r\n  // Quando o responsável muda, atualiza os projetos disponíveis\r\n  function handleUsuarioChange(novoIdUsuario) {\r\n    setIdUsuario(novoIdUsuario);\r\n\r\n    const projetosFiltrados = projetos.filter(\r\n      (p) =>\r\n        Number(p.usuario_id ?? p.usuarioId) ===\r\n        Number(novoIdUsuario)\r\n    );\r\n\r\n    const novoProjetoId = projetosFiltrados[0]?.id ?? \"\";\r\n\r\n    setIdProjeto(String(novoProjetoId));\r\n  }\r\n\r\n  // Salvar tarefa\r\n  async function handleSalvar() {\r\n    setErros([]);\r\n\r\n    if (!texto.trim()) {\r\n      setErros([\"O texto da tarefa não pode estar vazio.\"]);\r\n      return;\r\n    }\r\n\r\n    const usuarioIdCalculado = paraNumero(idUsuario);\r\n\r\n    if (!usuarioIdCalculado) {\r\n      setErros([\"Selecione um responsável válido para a tarefa.\"]);\r\n      return;\r\n    }\r\n\r\n    setSalvando(true);\r\n\r\n    try {\r\n      const prioridadeIdNum = paraNumero(idPrioridade) || 2;\r\n\r\n      const objPrioridade = listaPrioridades.find(\r\n        (p) =>\r\n          Number(p.id ?? p.idprioridade) === prioridadeIdNum\r\n      );\r\n\r\n      let prioridadeTexto = objPrioridade\r\n        ? objPrioridade.nome || objPrioridade.descricao\r\n        : null;\r\n\r\n      if (!prioridadeTexto) {\r\n        if (prioridadeIdNum === 1) {\r\n          prioridadeTexto = \"baixa\";\r\n        } else if (prioridadeIdNum === 3) {\r\n          prioridadeTexto = \"alta\";\r\n        } else {\r\n          prioridadeTexto = \"media\";\r\n        }\r\n      }\r\n\r\n      const textoPrioridade = String(prioridadeTexto)\r\n        .toLowerCase()\r\n        .normalize(\"NFD\")\r\n        .replace(/[\\u0300-\\u036f]/g, \"\");\r\n\r\n      // Projeto selecionado. Pode ser null se não houver projeto.\r\n      const projetoIdCalculado = paraNumero(idProjeto);\r\n\r\n      const textoFinal = texto.trim();\r\n      const colunaFinal = tarefa?.coluna || coluna || \"afazer\";\r\n\r\n      const payload = {\r\n        texto: textoFinal,\r\n        descricao: textoFinal,\r\n\r\n        coluna: colunaFinal,\r\n        status: colunaFinal,\r\n        situacao: colunaFinal,\r\n\r\n        prioridade: textoPrioridade,\r\n        idPrioridade: prioridadeIdNum,\r\n        idprioridade: prioridadeIdNum,\r\n        prioridade_id: prioridadeIdNum,\r\n        id_prioridade: prioridadeIdNum,\r\n\r\n        usuarioId: usuarioIdCalculado,\r\n        usuario_id: usuarioIdCalculado,\r\n      };\r\n\r\n      // Só envia o projeto quando existe um ID válido.\r\n      // Na edição, permite limpar um projeto anteriormente associado.\r\n      if (projetoIdCalculado) {\r\n        payload.projetoId = projetoIdCalculado;\r\n        payload.projeto_id = projetoIdCalculado;\r\n      } else if (tarefa?.id) {\r\n        payload.projetoId = null;\r\n        payload.projeto_id = null;\r\n      }\r\n\r\n      if (tarefa?.id) {\r\n        payload.id = tarefa.id;                         \r\n      }\r\n\r\n      await onSalvar(payload);\r\n\r\n      onFechar();\r\n    } catch (e) {\r\n      if (typeof mensagensDeErro === \"function\") {\r\n        setErros(mensagensDeErro(e));\r\n      } else {\r\n        setErros([\r\n          e.response?.data?.message ||\r\n            e.response?.data?.erro ||\r\n            \"Erro ao salvar a tarefa.\",\r\n        ]);\r\n      }\r\n    } finally {\r\n      setSalvando(false);\r\n    }\r\n  }\r\n\r\n  if (!aberto) return null;\r\n\r\n  return (\r\n    <div className={styles[\"modal-overlay\"]}>\r\n      <div className={styles[\"modal-content\"]}>\r\n        <h2>{tarefa ? \"Editar Tarefa\" : \"Nova Tarefa\"}</h2>\r\n\r\n        {/* Descrição da tarefa */}\r\n        <div className={styles.campo}>\r\n          <label htmlFor=\"tarefa-texto\">Tarefa</label>\r\n\r\n          <input\r\n            id=\"tarefa-texto\"\r\n            placeholder=\"Descreva a tarefa\"\r\n            value={texto}\r\n            onChange={(e) => setTexto(e.target.value)}\r\n          />\r\n        </div>\r\n\r\n        {/* Responsável */}\r\n        <div className={styles.campo}>\r\n          <label htmlFor=\"tarefa-responsavel\">\r\n            Responsável\r\n          </label>\r\n\r\n          <select\r\n            id=\"tarefa-responsavel\"\r\n            value={idUsuario}\r\n            onChange={(e) =>\r\n              handleUsuarioChange(e.target.value)\r\n            }\r\n          >\r\n            <option value=\"\">Selecione um responsável</option>\r\n\r\n            {usuarios.map((u) => (\r\n              <option key={u.id} value={String(u.id)}>\r\n                {u.nome}\r\n              </option>\r\n            ))}\r\n          </select>\r\n        </div>\r\n\r\n        {/* Projeto */}\r\n        <div className={styles.campo}>\r\n          <label htmlFor=\"tarefa-projeto\">Projeto</label>\r\n\r\n          <select\r\n            id=\"tarefa-projeto\"\r\n            value={String(idProjeto)}\r\n            onChange={(e) => setIdProjeto(e.target.value)}\r\n          >\r\n            <option value=\"\">\r\n              {projetosDoUsuario.length > 0\r\n                ? \"Selecione um projeto\"\r\n                : \"Nenhum projeto associado\"}\r\n            </option>\r\n\r\n            {projetosDoUsuario.map((p) => (\r\n              <option key={p.id} value={String(p.id)}>\r\n                {p.nome}\r\n              </option>\r\n            ))}\r\n          </select>\r\n        </div>\r\n\r\n        {/* Prioridade */}\r\n        <div className={styles.campo}>\r\n          <label htmlFor=\"tarefa-prioridade\">\r\n            Prioridade\r\n          </label>\r\n\r\n          <select\r\n            id=\"tarefa-prioridade\"\r\n            value={String(idPrioridade)}\r\n            onChange={(e) => setIdPrioridade(e.target.value)}\r\n          >\r\n            {listaPrioridades.map((p) => (\r\n              <option\r\n                key={p.id ?? p.idprioridade}\r\n                value={String(p.id ?? p.idprioridade)}\r\n              >\r\n                {p.descricao || p.nome}\r\n              </option>\r\n            ))}\r\n          </select>\r\n        </div>\r\n\r\n        {/* Mensagens de erro */}\r\n        {erros.length > 0 && (\r\n          <ul className={styles.erros}>\r\n            {erros.map((mensagem, i) => (\r\n              <li key={i}>{mensagem}</li>\r\n            ))}\r\n          </ul>\r\n        )}\r\n\r\n        {/* Botões */}\r\n        <div className={styles.botoes}>\r\n          <button\r\n            type=\"button\"\r\n            onClick={onFechar}\r\n            disabled={salvando}\r\n          >\r\n            Cancelar\r\n          </button>\r\n\r\n          <button\r\n            type=\"button\"\r\n            onClick={handleSalvar}\r\n            disabled={salvando}\r\n          >\r\n            {salvando ? \"Salvando...\" : \"Salvar\"}\r\n          </button>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  );\r\n}\r\n\r\nexport default ModalTarefa;\r\n"],"file":"/src/components/ModalTarefa.jsx"}